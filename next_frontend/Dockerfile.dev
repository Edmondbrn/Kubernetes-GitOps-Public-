FROM node:22-alpine 

# Install pnpm globally
RUN npm install -g pnpm

# create the work directory
WORKDIR /app

# Init the Node user (increase security)
RUN chown -R node:node /app

# import start file ans change permission
COPY start_frontend.sh .
RUN chmod +x start_frontend.sh

# give owner access to pnpm store
RUN mkdir -p /home/node/.local/share/pnpm && \
    chown -R node:node /home/node/.local/share/pnpm

USER node
# Clean install dependencies as Node
COPY --chown=node:node package.json pnpm-lock.yaml ./
# install node packages with cache and builds external dependencies automatically
RUN --mount=type=cache,id=pnpm,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000 \
    pnpm install \
    --frozen-lockfile
# load the app files as Node
COPY --chown=node:node . .

# Accept build-time environment variables
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# start the app
ENTRYPOINT ["sh", "./start_frontend.sh"]
